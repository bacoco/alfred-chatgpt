  "policy_version": "unconfigured-v1",
  "mode": "storage_only",
  "live_processing_enabled": false,
  "scheduler_enabled": false,
  "external_actions_enabled": false,
  "instruction_source": {
    "repository": "bacoco/alfred-chatgpt",
    "branch": "main",
