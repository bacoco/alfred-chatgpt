  },
  "source_accounts": [],
  "active_mandates": [],
  "state_paths": {
    "tasks": "state/tasks.json",
    "profile": "memory/profile.json",
    "cases": "state/cases.json",
    "decisions": "state/decisions.json",
    "checkpoints": "state/checkpoints.json",
    "runtime": "state/runtime.json",
    "delivery": "state/delivery.json",
    "setup": "state/setup.json",
    "subscriptions": "state/subscriptions.json"
  },
  "private_storage": {
    "repository": "{{PRIVATE_REPO}}",
    "branch": "{{PRIVATE_BRANCH}}",
